# This repo no longer runs a Next.js/Supabase app. The system is a Bigcapital
# source fork deployed on the VM via deploy/bigcapital/.
#
# VM access used by the deploy/*.py helper scripts (SSH). Do not commit real
# values — copy this file to .env.local (gitignored) and fill it in there,
# then update the scripts to read from env instead of hardcoded values.
VM_SSH_HOST=127.0.0.1
VM_SSH_PORT=2222
VM_SSH_USER=astrans
VM_SSH_PASSWORD=change_me

# Astrans Books (Bigcapital) public URL
BIGCAPITAL_URL=https://books.astransdms.xyz
