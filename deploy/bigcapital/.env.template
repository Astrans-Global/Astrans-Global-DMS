# Copy to /opt/bigcapital/.env on the VM and edit secrets.
# Do not commit real passwords.

# Database
DB_HOST=mysql
DB_USER=bigcapital
DB_PASSWORD=CHANGE_ME_STRONG
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_STRONG
DB_CHARSET=utf8
SYSTEM_DB_NAME=bigcapital_system
TENANT_DB_NAME_PERFIX=bigcapital_tenant_

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT
APP_JWT_SECRET=CHANGE_ME_LONG_RANDOM_APP_JWT

# Public URL (Cloudflare Tunnel hostname)
BASE_URL=https://books.astransdms.xyz

# Proxy
PUBLIC_PROXY_PORT=80
PUBLIC_PROXY_SSL_PORT=443

# Signup — create first admin, then set SIGNUP_DISABLED=true and restart
SIGNUP_DISABLED=false
SIGNUP_ALLOWED_DOMAINS=
SIGNUP_ALLOWED_EMAILS=
SIGNUP_EMAIL_CONFIRMATION=false

# Mail (optional for first boot)
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_FROM_NAME=Astrans Books
MAIL_FROM_ADDRESS=noreply@astransdms.xyz

# Gotenberg
GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_DOCS_URL=http://server:3000/public/

API_RATE_LIMIT=120,60,600
EXCHANGE_RATE_SERVICE=open-exchange-rate
OPEN_EXCHANGE_RATE_APP_ID=
BANK_FEED_ENABLED=false
HOSTED_ON_BIGCAPITAL_CLOUD=false
